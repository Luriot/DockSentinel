{
  "name": "docksentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight Docker vulnerability monitoring and alerting, built on Trivy",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "test:ui": "playwright test",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
