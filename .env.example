# DockSentinel environment variables (all optional unless noted).
# Copy to .env and adjust for docker compose.

# --- Runtime -----------------------------------------------------------------
# Directory holding the database, encryption key, scanner cache and scan scratch space.
DATA_DIR=/data
# HTTP listener.
HOST=0.0.0.0
PORT=8080
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Dated text logs are written to DATA_DIR/logs/docksentinel-YYYY-MM-DD.log (one file per day).
# Number of days of log files to keep.
LOG_RETENTION_DAYS=14
# Set to true when DockSentinel is behind a trusted reverse proxy that sets
# X-Forwarded-* headers correctly. Required for Secure cookies over HTTPS.
TRUST_PROXY=false
# auto | always | never. "auto" marks the session cookie Secure when the request is HTTPS.
COOKIE_SECURE=auto

# --- First-run setup ----------------------------------------------------------
# Optional. When empty, a random token is printed once in the container logs.
SETUP_TOKEN=

# --- Secrets ------------------------------------------------------------------
# 32 bytes, base64 or 64-char hex. When empty, a key is generated in DATA_DIR/secret.key.
# Losing this key invalidates stored TLS material and notification credentials
# (findings and history are unaffected).
DOCKSENTINEL_SECRET_KEY=

# --- Backups ------------------------------------------------------------------
# Automatic SQLite snapshot interval in hours (0 disables automatic backups).
# Snapshots include a copy of secret.key when the key is file-based.
BACKUP_INTERVAL_HOURS=24
# Number of snapshots kept in DATA_DIR/backups; older ones (and their keys) are removed.
BACKUP_RETENTION=3

# --- Scanner ------------------------------------------------------------------
# Trivy binary and cache directory. The production image bundles Trivy.
TRIVY_BIN=trivy
TRIVY_CACHE_DIR=/data/trivy-cache
# Hard limits that protect the host from a runaway scan or image export.
# The standard profile uses SCAN_TIMEOUT_MS as its timeout (quick stays at 5 minutes).
SCAN_TIMEOUT_MS=900000
SCAN_MAX_OUTPUT_BYTES=100663296
MAX_IMAGE_EXPORT_BYTES=8589934592
IMAGE_EXPORT_TIMEOUT_MS=600000
# Upper bound; the effective concurrency is the lower of this and the UI setting.
SCAN_CONCURRENCY=2

# --- Known-exploited intelligence --------------------------------------------
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Container permissions (compose / Unraid) --------------------------------
PUID=10001
PGID=10001
# GID that owns /var/run/docker.sock on the host. Needed for local socket access
# as a non-root user. Docker Desktop uses 0; on Unraid this is usually the
# "users" group (check with: stat -c '%g' /var/run/docker.sock).
DOCKER_GID=999
